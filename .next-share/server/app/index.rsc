b:["$","$1","c",{"children":[[["$","$L16",null,{}],["$","$L17",null,{}],["$","$L18",null,{}],["$","section",null,{"className":"section","id":"services","children":["$","div",null,{"className":"shell","children":[["$","$L19",null,{"kicker":{"en":"Our Services","ar":"خدماتنا"},"title":{"en":"Everything you need, in one box.","ar":"كل ما تحتاجه، في صندوق واحد."},"body":{"en":"Fourteen disciplines under one roof, so your brand, your website and your software never contradict each other.","ar":"أربعة عشر تخصصاً تحت سقف واحد، حتى لا تتناقض علامتك مع موقعك أو برمجياتك."},"cta":{"en":"All services","ar":"كل الخدمات"},"ctaHref":"/services"}],["$","$L1a",null,{"items":[{"slug":"digital-marketing","num":"01","icon":"megaphone","title":{"en":"Digital Marketing","ar":"التسويق الرقمي"},"short":{"en":"Performance campaigns across Google, Meta, TikTok and Snap that turn spend into measurable revenue.","ar":"حملات أداء عبر جوجل وميتا وتيك توك وسناب تُحوّل الإنفاق إلى إيرادات قابلة للقياس."},"bullets":{"en":["Paid search & social ads","Campaign strategy & funnels","Analytics & conversion tracking","Monthly reporting & optimisation"],"ar":["إعلانات البحث والمنصات الاجتماعية","استراتيجية الحملات ومسارات التحويل","التحليلات وتتبّع التحويلات","تقارير شهرية وتحسين مستمر"]}},{"slug":"web-development","num":"02","icon":"code","title":{"en":"Web Development","ar":"تطوير المواقع"},"short":{"en":"Fast, secure, bilingual websites built to load in under two seconds and rank on page one.","ar":"مواقع سريعة وآمنة وثنائية اللغة، تُحمّل في أقل من ثانيتين وتتصدّر نتائج البحث."},"bullets":{"en":["Corporate & landing pages","Headless CMS integration","Core Web Vitals optimisation","Bilingual EN / AR with RTL"],"ar":["مواقع تعريفية وصفحات هبوط","ربط أنظمة إدارة المحتوى","تحسين سرعة الأداء","ثنائية اللغة مع دعم RTL"]}},{"slug":"business-software","num":"03","icon":"chip","title":{"en":"Software for Your Business","ar":"برمجيات مخصّصة لأعمالك"},"short":{"en":"Custom tools built around how your team actually works — not the other way around.","ar":"أدوات مخصّصة تُبنى على طريقة عمل فريقك فعلياً، لا العكس."},"bullets":{"en":["ERP, CRM & inventory systems","Workflow automation","Legacy system modernisation","Third-party API integrations"],"ar":["أنظمة تخطيط الموارد وإدارة العملاء والمخزون","أتمتة سير العمل","تحديث الأنظمة القديمة","ربط واجهات البرمجة الخارجية"]}},{"slug":"end-to-end","num":"04","icon":"layers","title":{"en":"End-to-End Software Solutions","ar":"حلول برمجية متكاملة"},"short":{"en":"From discovery workshops to deployment, hosting and support — one team owns the whole journey.","ar":"من ورش الاكتشاف إلى النشر والاستضافة والدعم — فريق واحد يتولى الرحلة كاملة."},"bullets":{"en":["Discovery & product roadmap","Architecture & UI/UX design","Development & QA","Deployment, hosting & AMC"],"ar":["الاكتشاف وخريطة المنتج","المعمارية وتصميم التجربة","التطوير وضمان الجودة","النشر والاستضافة والصيانة"]}},{"slug":"branding","num":"05","icon":"crown","title":{"en":"Company Branding","ar":"بناء العلامة التجارية"},"short":{"en":"Identity systems that look timeless in the boardroom and unmistakable on the street.","ar":"أنظمة هوية تبدو خالدة في قاعة الاجتماعات ولا تُخطأ في الشارع."},"bullets":{"en":["Logo & visual identity","Brand guidelines & tone of voice","Packaging & print collateral","Rebranding & brand refresh"],"ar":["الشعار والهوية البصرية","دليل العلامة ونبرة الخطاب","التغليف والمطبوعات","إعادة بناء العلامة وتحديثها"]}},{"slug":"social-media","num":"06","icon":"share","title":{"en":"Social Media Handling","ar":"إدارة وسائل التواصل الاجتماعي"},"short":{"en":"Bilingual content, community management and reporting that keep your brand in the conversation.","ar":"محتوى ثنائي اللغة، وإدارة مجتمع، وتقارير تُبقي علامتك حاضرة في الحوار."},"bullets":{"en":["Content calendars & copywriting","Reels, shorts & studio production","Community management","Influencer & campaign support"],"ar":["خطط المحتوى وكتابة النصوص","ريلز وفيديوهات قصيرة وإنتاج","إدارة المجتمع والتفاعل","دعم المؤثرين والحملات"]}},{"slug":"mobile-apps","num":"07","icon":"phone","title":{"en":"Mobile App Development","ar":"تطوير تطبيقات الجوال"},"short":{"en":"Native and cross-platform apps for iOS and Android, published and maintained end to end.","ar":"تطبيقات أصلية ومتعددة المنصات لأنظمة iOS وAndroid، من النشر إلى الصيانة."},"bullets":{"en":["iOS & Android apps","Flutter / React Native","App Store & Play deployment","Push, payments & maps"],"ar":["تطبيقات iOS وAndroid","فلاتر / رياكت نيتف","النشر في المتاجر","الإشعارات والدفع والخرائط"]}},{"slug":"ui-ux","num":"08","icon":"pen","title":{"en":"UI / UX Design","ar":"تصميم واجهات وتجربة المستخدم"},"short":{"en":"Interfaces shaped by research and testing, designed in both English and Arabic layouts.","ar":"واجهات مبنية على البحث والاختبار، مصمّمة بالعربية والإنجليزية معاً."},"bullets":{"en":["User research & wireframes","Design systems & prototypes","Usability testing","RTL design adaptation"],"ar":["بحث المستخدمين والمخططات الأولية","أنظمة التصميم والنماذج","اختبارات سهولة الاستخدام","مواءمة التصاميم للعربية"]}},{"slug":"seo","num":"09","icon":"search","title":{"en":"SEO & Content","ar":"تحسين محركات البحث والمحتوى"},"short":{"en":"Technical SEO and Arabic-first content that put your business in front of buyers who are ready.","ar":"تحسين تقني ومحتوى عربي يضع نشاطك أمام المشترين الجاهزين."},"bullets":{"en":["Technical & on-page SEO","Arabic & English keyword research","Content strategy & writing","Local SEO for KSA & GCC"],"ar":["تحسين تقني وداخلي","بحث الكلمات بالعربية والإنجليزية","استراتيجية المحتوى وكتابته","تحسين محلي للسعودية والخليج"]}},{"slug":"ecommerce","num":"10","icon":"cart","title":{"en":"E-commerce Solutions","ar":"حلول التجارة الإلكترونية"},"short":{"en":"Storefronts that convert, with payments, shipping and inventory wired in from day one.","ar":"متاجر تُحوّل الزوار إلى مشترين، مع ربط الدفع والشحن والمخزون من اليوم الأول."},"bullets":{"en":["Shopify, WooCommerce & custom","Payment gateway integration","Shipping & inventory setup","Conversion rate optimisation"],"ar":["شوبيفاي وووكومرس وحلول مخصّصة","ربط بوابات الدفع","إعداد الشحن والمخزون","تحسين معدل التحويل"]}},{"slug":"production","num":"11","icon":"camera","title":{"en":"Video Production & Photography","ar":"إنتاج الفيديو والتصوير"},"short":{"en":"Brand films, product shoots and photography produced by a crew that understands marketing.","ar":"أفلام للعلامة وتصوير منتجات وجلسات احترافية، من فريق يفهم التسويق."},"bullets":{"en":["Brand & corporate films","Product & food photography","Event coverage & reels","Editing, colour & sound"],"ar":["أفلام تعريفية ومؤسسية","تصوير المنتجات والطعام","تغطية الفعاليات والريلز","المونتاج والتلوين والصوت"]}},{"slug":"cloud","num":"12","icon":"cloud","title":{"en":"Cloud, DevOps & IT Support","ar":"الحوسبة السحابية والدعم التقني"},"short":{"en":"Reliable infrastructure, backups and monitoring — plus a support desk that actually answers.","ar":"بنية تحتية موثوقة ونسخ احتياطية ومراقبة، مع دعم فني يردّ فعلاً."},"bullets":{"en":["AWS / Azure hosting & migration","CI/CD & automated backups","Security hardening & monitoring","AMC & helpdesk support"],"ar":["استضافة وترحيل على AWS وAzure","التكامل المستمر والنسخ التلقائي","تأمين الأنظمة والمراقبة","عقود صيانة ودعم فني"]}},{"slug":"ai","num":"13","icon":"spark","title":{"en":"AI & Business Automation","ar":"الذكاء الاصطناعي وأتمتة الأعمال"},"short":{"en":"Practical AI — chatbots, document automation and dashboards that remove hours of manual work.","ar":"ذكاء اصطناعي عملي: روبوتات محادثة، وأتمتة المستندات، ولوحات بيانات تُختصر ساعات من العمل اليدوي."},"bullets":{"en":["Chatbots & AI assistants","Document & data automation","Business intelligence dashboards","Process consulting"],"ar":["روبوتات المحادثة والمساعدات الذكية","أتمتة المستندات والبيانات","لوحات ذكاء الأعمال","استشارات إعادة هندسة العمليات"]}},{"slug":"print","num":"14","icon":"print","title":{"en":"Graphic Design & Print","ar":"التصميم الجرافيكي والمطبوعات"},"short":{"en":"Brochures, signage, vehicle wraps and exhibition stands — print that carries the brand offline.","ar":"كتيبات ولافتات وتغليف مركبات وأجنحة معارض — مطبوعات تحمل علامتك خارج الإنترنت."},"bullets":{"en":["Brochures & catalogues","Signage & vehicle branding","Exhibition & booth design","Print production management"],"ar":["كتيبات وفهارس","اللافتات وتغليف المركبات","تصميم أجنحة المعارض","إدارة إنتاج الطباعة"]}}]}]]}]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"],null,"$L23"]}]
